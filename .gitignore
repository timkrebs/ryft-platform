# Secrets and state anywhere in the tree, also in the folders D3 removed (D246): a clone keeps its
# git-ignored files there (deploy/k8s's secrets.yaml, infra/aws's and infra/vault's terraform.tfvars,
# .terraform/), and with the folders' own .gitignore gone they must stay out of `git add -A`.
secrets.yaml
secrets/
terraform.tfvars
*.tfstate
*.tfstate.*
.terraform/
backend/bin/
.env
*.xcuserstate
xcuserdata/
DerivedData/
.DS_Store
# Terraform plan files can hold secrets in plaintext
tfplan
*.tfplan
# Per-session milestone specs; they stay local
CLAUDE_FOLLOWUP_*.md
__pycache__/
# Stray `go build ./cmd/<name>` outputs in backend/ (two were committed by accident in c8b107e)
/backend/api
/backend/scoring
/backend/ingest
/backend/notify
/backend/migrate
/backend/rabbitmq-topology

# k6 output of scripts/load.sh (make load)
scripts/load/out/
