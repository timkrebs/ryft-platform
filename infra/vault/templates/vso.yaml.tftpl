# Generated by infra/vault — do not edit by hand (terraform apply rewrites it).
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultConnection
metadata:
  name: vault
  namespace: ${k8s_ns}
spec:
  address: ${vault_address}
  skipTLSVerify: false
%{ if vault_ca_b64 != "" ~}
  caCertSecretRef: vault-ca
%{ endif ~}
---
%{ if vault_ca_b64 != "" ~}
apiVersion: v1
kind: Secret
metadata:
  name: vault-ca
  namespace: ${k8s_ns}
type: Opaque
data:
  ca.crt: ${vault_ca_b64}
---
%{ endif ~}
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultAuth
metadata:
  name: ${service}
  namespace: ${k8s_ns}
spec:
  vaultConnectionRef: vault
  # From the root namespace: on HCP Vault Dedicated this starts with admin/.
  namespace: ${vault_ns}
  method: kubernetes
  mount: ${auth_mount}
  kubernetes:
    role: ${role}
    serviceAccount: ${service_account}
    audiences: ["vault"]
%{ if has_secret ~}
---
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultStaticSecret
metadata:
  name: ${project}-secrets
  namespace: ${k8s_ns}
spec:
  vaultAuthRef: ${service}
  mount: ${kv_mount}
  type: kv-v2
  path: config
  refreshAfter: 1h
  destination:
    name: ${project}-secrets
    create: true
    overwrite: true
    # Only the keys themselves: no `_raw` copy of the whole secret, which envFrom
    # would turn into one more variable holding every credential.
    transformation:
      excludeRaw: true
%{ if restart_kind != "" ~}
  rolloutRestartTargets:
    - kind: ${restart_kind}
      name: ${restart_name}
%{ endif ~}
%{ endif ~}
