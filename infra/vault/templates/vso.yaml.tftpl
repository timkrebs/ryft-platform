# Generated by infra/vault — do not edit by hand (terraform apply rewrites it).
# The in-cluster Vault's trust: cert-manager writes Secret vault-ca, whose ca.crt the VaultConnection names once
# this namespace reads that Vault (D190). Only ca.crt is used; the leaf is inert (no SAN, and ryft-vault is no CA
# the broker trusts).
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: vault-ca
  namespace: ${k8s_ns}
spec:
  secretName: vault-ca
  commonName: vso.${k8s_ns}
  duration: 8760h
  privateKey:
    algorithm: ECDSA
    size: 256
    rotationPolicy: Always
  usages:
    - digital signature
  issuerRef:
    name: ryft-vault
    kind: ClusterIssuer
    group: cert-manager.io
---
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultConnection
metadata:
  name: vault
  namespace: ${k8s_ns}
%{ if target == "k8s" ~}
  annotations:
    argocd.argoproj.io/sync-wave: "0"
%{ endif ~}
spec:
  address: ${vault_address}
  skipTLSVerify: false
%{ if target == "k8s" ~}
  caCertSecretRef: vault-ca
%{ endif ~}
---
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultAuth
metadata:
  name: ${service}
  namespace: ${k8s_ns}
%{ if target == "k8s" ~}
  annotations:
    argocd.argoproj.io/sync-wave: "0"
%{ endif ~}
spec:
  vaultConnectionRef: vault
%{ if target == "k8s" ~}
  # Vault Community Edition: no namespace (the isolation is the role, the policy and the mount).
%{ else ~}
  # From the root namespace: on HCP Vault Dedicated this starts with admin/.
  namespace: ${vault_ns}
%{ endif ~}
  method: kubernetes
  mount: ${auth_mount}
  kubernetes:
    role: ${role}
    serviceAccount: ${service_account}
    audiences: ["vault"]
%{ if has_secret ~}
---
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultStaticSecret
metadata:
  name: ${project}-secrets
  namespace: ${k8s_ns}
%{ if target == "k8s" ~}
  annotations:
    argocd.argoproj.io/sync-wave: "1"
%{ endif ~}
spec:
  vaultAuthRef: ${service}
  mount: ${kv_mount}
  type: kv-v2
  path: config
  refreshAfter: 1h
  destination:
    name: ${project}-secrets
    create: true
    overwrite: true
    # Only the keys themselves: no `_raw` copy of the whole secret, which envFrom
    # would turn into one more variable holding every credential.
    transformation:
      excludeRaw: true
%{ if length(restart_targets) > 0 ~}
  rolloutRestartTargets:
%{ for t in restart_targets ~}
    - kind: ${t.kind}
      name: ${t.name}
%{ endfor ~}
%{ endif ~}
%{ endif ~}
%{ for u in amqp_users ~}
---
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultStaticSecret
metadata:
  name: amqp-user-${u}
  namespace: ${k8s_ns}
%{ if target == "k8s" ~}
  annotations:
    argocd.argoproj.io/sync-wave: "1"
%{ endif ~}
spec:
  vaultAuthRef: ${service}
  mount: ${kv_mount}
  type: kv-v2
  path: amqp-user-${u}
  refreshAfter: 1h
  destination:
    name: amqp-user-${u}
    create: true
    overwrite: true
    # The Topology Operator imports a user's credentials only from a Secret with this
    # label (it refuses the User object otherwise).
    labels:
      rabbitmq.com/topology-operator: "true"
    transformation:
      excludeRaw: true
%{ endfor ~}
