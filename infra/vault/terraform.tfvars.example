region           = "eu-central-1"
eks_cluster_name = "ryft-prod-euc1"
project          = "ryft"

# Retired with HCP Vault (D207); a line that sets one of these fails the plan and names itself:
# vault_parent_namespace_root, vault_address, vault_address_for_cluster, vault_ca_bundle_b64.
# Every generated VaultConnection names https://vault.vault.svc:8200 and trusts the cert-manager
# Secret vault-ca (D190).

# The in-cluster Vault (Community Edition), the only Vault this root writes. Terraform reaches it
# only through `kubectl --context ryft-prod-euc1 -n vault port-forward svc/vault-active 8200:8200`
# (docs/OPERATIONS.md -> Vault -> Terraform through the port-forward); every plan and apply needs
# the port-forward, the CA file and the token. The defaults are the runbook's:
# vault_k8s_address      = "https://127.0.0.1:8200"        # loopback only (validated)
# vault_k8s_ca_cert_file = "~/.config/ryft/vault-ca.pem"   # ca.crt of the Secret vault/vault-ca
# The token is never in this file: export TF_VAR_vault_k8s_token (an ephemeral variable, never in
# state or plan), a token of the token role terraform (1 hour, not renewable) created with the
# admin token of a generate-root session (docs/OPERATIONS.md -> Vault -> Login, D209).

# Supabase (docs/SUPABASE.md). The database and RabbitMQ passwords of the services are
# generated here; you only provide the owner password, which only the migrate
# namespace receives.
supabase_project_ref    = "<ref>"
database                = { host = "aws-<n>-eu-central-1.pooler.supabase.com" } # Connect → Session pooler
database_owner_password = "<database password>"

# Per-service credentials. Keys land only in that service's kv-<service>/config.
# Shared settings, each delivered only to the services that list it in secret_keys.
# BETA_GATE (api, ingest; default off) and CONSENT_ENFORCE (api, ingest, scoring;
# default on) are off|warn|on: warn serves the request and flags it in X-RYFT-Gate
# (docs/OPERATIONS.md → Beta). Before the first external invite both are on.
# shared_secrets = { BETA_GATE = "on", CONSENT_ENFORCE = "on" }

service_secrets = {
  api = {
    SUPABASE_SERVICE_ROLE_KEY = "sb_secret_…" # Project Settings → API Keys; account deletion
    # Sign in with Apple token revocation on DELETE /v1/me (docs/SUPABASE.md → Apple):
    APPLE_TEAM_ID   = "M77SKHKG63"        # Apple Developer → Membership
    APPLE_KEY_ID    = "<key id>"          # Certificates, IDs & Profiles → Keys → the Sign in with Apple key
    APPLE_CLIENT_ID = "dev.timkrebs.ryft" # the app's bundle ID (native sign-in), not a Services ID
    # The whole AuthKey_<key id>.p8 (downloadable once), either as one line,
    # base64 -i AuthKey_<key id>.p8 | tr -d '\n', or pasted between the EOT lines.
    APPLE_KEY_P8 = <<-EOT
      -----BEGIN PRIVATE KEY-----
      …the contents of AuthKey_<key id>.p8…
      -----END PRIVATE KEY-----
    EOT
  }
  # Argo CD's PostSync smoke after every deploy (D95): the dedicated smoke user's sign-in,
  # the same three values make smoke-prod takes. Without them every sync fails its smoke.
  smoke = {
    SUPABASE_ANON_KEY = "sb_publishable_…" # Project Settings → API Keys (the publishable/anon key)
    SMOKE_EMAIL       = "smoke@ryftapp.de"
    SMOKE_PASSWORD    = "…"
  }
  # Grafana Cloud → Kubernetes Monitoring → the collector's access policy token (glc_…),
  # and the stack's Prometheus user (a number, not a secret) OpenCost reads with it.
  monitoring = { GC_TOKEN = "glc_…", PROM_USERNAME = "3085952" }
  # coach  = { ANTHROPIC_API_KEY = "sk-ant-…" }
  # Push (docs/OPERATIONS.md → Push): Apple Developer → Keys → a key with "Apple Push
  # Notifications service"; all three or none (without them notify sends nothing).
  # notify = {
  #   APNS_KEY_ID  = "<key id>"   # 10 characters
  #   APNS_TEAM_ID = "M77SKHKG63" # Apple Developer → Membership
  #   APNS_KEY_P8  = <<-EOT
  #     -----BEGIN PRIVATE KEY-----
  #     …the contents of AuthKey_<key id>.p8…
  #     -----END PRIVATE KEY-----
  #   EOT
  # }
}

# Add a service: one line here creates its Kubernetes namespace and service account, and on
# the in-cluster Vault its mount kv-<name>, policy and role, plus the VSO manifests (a
# database = "role" also needs a migration creating ryft_<name> and an entry in
# backend/internal/db.ServiceRoles). The policy terraform must name it first: render
# bootstrap/terraform.hcl, write it with a generate-root session's root token, then apply
# (infra/vault/README.md).
# services = {
#   ingest   = { secret_keys = ["SUPABASE_PROJECT_REF"], database = "role", amqp = "client" }
#   scoring  = { database = "role", amqp = "client" }
#   api      = { secret_keys = ["SUPABASE_PROJECT_REF"], database = "role", amqp = "client" }
#   rabbitmq = { amqp = "server", workload_kind = "" }
#   migrate  = { database = "owner", workload_kind = "" }
# }
