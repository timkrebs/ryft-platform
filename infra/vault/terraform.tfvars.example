region                      = "eu-central-1"
eks_cluster_name            = "ryft-prod-euc1"
project                     = "ryft"
vault_parent_namespace_root = "admin" # "admin" on HCP Vault Dedicated; "" on self-managed Enterprise
vault_address_for_cluster   = "https://<cluster>.hashicorp.cloud:8200" # Terraform uses it too
# vault_address             = "https://…"         # only if Terraform reaches Vault at another address
# vault_ca_bundle_b64       = "LS0tLS1CRUdJTi..."  # only for a private CA

# Supabase (docs/SUPABASE.md). The database and NATS passwords of the services are
# generated here; you only provide the owner password, which only the migrate
# namespace receives.
supabase_project_ref    = "<ref>"
database                = { host = "aws-<n>-eu-central-1.pooler.supabase.com" } # Connect → Session pooler
database_owner_password = "<database password>"

# Per-service credentials. Keys land only in that service's kv/config.
service_secrets = {
  api = {
    SUPABASE_SERVICE_ROLE_KEY = "sb_secret_…" # Project Settings → API Keys; account deletion
    # Sign in with Apple token revocation on DELETE /v1/me (docs/SUPABASE.md → Apple):
    APPLE_TEAM_ID   = "M77SKHKG63"        # Apple Developer → Membership
    APPLE_KEY_ID    = "<key id>"          # Certificates, IDs & Profiles → Keys → the Sign in with Apple key
    APPLE_CLIENT_ID = "dev.timkrebs.ryft" # the app's bundle ID (native sign-in), not a Services ID
    # The whole AuthKey_<key id>.p8 (downloadable once), either as one line,
    # base64 -i AuthKey_<key id>.p8 | tr -d '\n', or pasted between the EOT lines.
    APPLE_KEY_P8 = <<-EOT
      -----BEGIN PRIVATE KEY-----
      …the contents of AuthKey_<key id>.p8…
      -----END PRIVATE KEY-----
    EOT
  }
  # Grafana Cloud → Kubernetes Monitoring → the collector's access policy token (glc_…).
  monitoring = { GC_TOKEN = "glc_…" }
  # coach  = { ANTHROPIC_API_KEY = "sk-ant-…" }
  # notify = { APNS_KEY_ID = "…", APNS_TEAM_ID = "…", APNS_KEY_P8 = "-----BEGIN PRIVATE KEY-----…" }
}

# Add a service: one line here creates its Vault namespace, Kubernetes namespace,
# auth mount, KV, policy and VSO manifests (a database = "role" also needs a
# migration creating ryft_<name> and an entry in backend/internal/db.ServiceRoles).
# services = {
#   ingest  = { secret_keys = ["SUPABASE_PROJECT_REF"], database = "role", nats = "client" }
#   scoring = { database = "role", nats = "client" }
#   api     = { secret_keys = ["SUPABASE_PROJECT_REF"], database = "role", nats = "client" }
#   nats    = { nats = "server", workload_kind = "StatefulSet" }
#   migrate = { database = "owner", workload_kind = "" }
# }
