# Vault Secrets Operator manifests, one kustomize directory per service, generated from the values above so the
# Kubernetes side can never drift from the Vault side. Argo CD applies them in wave 0 (vault-<svc>; monitoring and
# the import service by hand, docs/OPERATIONS.md). One VaultConnection per service namespace, so no cross-namespace
# reference is needed. Every namespace reads the in-cluster Vault (D207): its address with caCertSecretRef vault-ca
# (the Certificate below, D190), no Vault namespace (CE), the mount kv-<svc>, and the in-app sync waves (connection
# and auth before the secrets, design 9.1).
#
# Everything here is plan-time known (locals and configured arguments, no provider-computed value), which is what
# lets the tests pin the output against tests/golden/k8s/ (tests/vault.tftest.hcl). The committed
# deploy/k8s/overlays/vault-namespaces/ are still HCP's render until the first apply rewrites them; the follow-up PR
# that commits them also pins them to this render (docs/work/2026-11-13-rebuild/followup-overlays.md), so from then
# on a PR cannot ship files an apply would rewrite.

resource "local_file" "vso" {
  for_each = local.services

  filename        = "${path.module}/${var.vso_output_dir}/${each.key}/vault.yaml"
  file_permission = "0644"
  content = templatefile("${path.module}/templates/vso.yaml.tftpl", {
    project         = var.project
    service         = each.key
    k8s_ns          = each.value.k8s_ns
    vault_address   = local.vault_k8s_address_for_cluster
    auth_mount      = vault_auth_backend.k8s.path
    role            = vault_kubernetes_auth_backend_role.k8s_service[each.key].role_name
    service_account = each.value.service_account
    kv_mount        = vault_mount.k8s_kv[each.key].path
    has_secret      = contains(keys(local.services_with_secrets), each.key)
    restart_targets = each.value.restart_targets
    amqp_users      = each.value.amqp == "server" ? local.amqp_clients : []
  })
}

resource "local_file" "vso_kustomization" {
  for_each = local.services

  filename        = "${path.module}/${var.vso_output_dir}/${each.key}/kustomization.yaml"
  file_permission = "0644"
  content         = <<-YAML
    # Generated by infra/vault — do not edit by hand (terraform apply rewrites it).
    apiVersion: kustomize.config.k8s.io/v1beta1
    kind: Kustomization
    namespace: ${each.value.k8s_ns}
    resources:
      - vault.yaml
  YAML
}
