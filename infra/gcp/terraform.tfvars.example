# Placeholders only. This root reads no local tfvars: every value below is a workspace variable of
# ryft-gcp in ryft-lab (terraform category, docs/OPERATIONS.md -> GCP, step 2e), set once.
# The gates are not here: they live in gates.auto.tfvars (reviewed: serve, public_invokers and
# edge, D242), and the topology in pubsub.auto.tfvars.json (generated).

# gh api repos/timkrebs/ryft-platform --jq '.id, .owner.id'
github_repository_id       = "<repository id, digits>"
github_repository_owner_id = "<owner id, digits>"

# Search Console -> add the domain property ryftlab.de -> the TXT value it shows (public).
google_site_verification = "google-site-verification=<value from Search Console>"

# From runbook step 11.1: the Google Cloud app's channel, by its resource name. Until it is set, no
# alert policy exists and no channel is read (alerts.tf). Unset is unset, never "".
# alert_app_channel = "projects/<project>/notificationChannels/<number>"
# Per device: a workspace variable only (HCL off, Sensitive off), never in a committed file.

# Who may mint ryft-smoke's ID token for `make smoke-prod` (D286), besides CI's ryft-deployer: user: or
# group: members only. Personal, so a workspace variable only (HCL on, Sensitive off). Default [].
# smoke_token_creators = ["user:<operator's Google account email>"]

# Defaults, change only with a reason:
# project_id = "ryftlab-prod"
# region     = "europe-west1"

# Nutrition ETL, opt-in HCP Terraform variable (HCL on). Bootstrap with an empty object.
# nutrition_etl = {}
# Pin the scanned Job image digest and Secret Manager version before creating the paused import job.
