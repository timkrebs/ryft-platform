# Copy to terraform.tfvars (git-ignored) and adjust.

region      = "eu-central-1"
project     = "ryft"
environment = "prod"

# Who may reach the public Kubernetes API: the addresses Terraform, kubectl and helm run from
# (curl -s https://checkip.amazonaws.com). The Vault in the cluster (the only one, D207) calls
# TokenReview over the private endpoint, so it needs no entry here. The API itself still
# requires IAM authentication.
endpoint_public_access_cidrs = ["0.0.0.0/0"]

deletion_protection = true

# Three nodes, one per zone (D57): 51 pod slots, one RabbitMQ node each, and every
# broker volume always has a node in its zone. The module ignores desired_size after
# creation; change it with
# aws eks update-nodegroup-config, then here.
node_group = {
  instance_types = ["t3.large"] # 35 pods and 8 GiB per node (D64); changing the type replaces the node group
  min_size       = 3
  max_size       = 4
  desired_size   = 3

  # Graviton is ~20 % cheaper; the RYFT images are multi-arch:
  # ami_type       = "AL2023_ARM_64_STANDARD"
  # instance_types = ["t4g.medium"]
}

tags = {
  Owner = "platform-team"
}

# Monthly cost alarm (AWS Budgets, USD; 165 ≈ €150): alerts at 80 % spent and 100 % forecast.
budget_alert_emails = ["you@example.com"]
# monthly_budget_usd = 165

# Vault's unseal key: only these principals may use it (off while empty). Enable it only after
# the in-cluster Vault has unsealed once with its Pod Identity role (README → Unseal key
# allowlist); a list without that role keeps every restarted Vault pod sealed. Exact ARNs are
# stricter than patterns (a * also matches /): the role's from
# `terraform -chdir=infra/aws/kubernetes output -raw vault_unseal_role_arn`, yours from
# `aws iam list-roles --path-prefix /aws-reserved/ --query 'Roles[].Arn'`.
# vault_unseal_allowed_principal_arns = [
#   "arn:aws:iam::111122223333:role/ryft-prod-euc1-vault-unseal-*", # or the exact role ARN
#   "arn:aws:iam::111122223333:role/aws-reserved/sso.amazonaws.com/*AWSReservedSSO_AdministratorAccess_*", # your admin role, for restores
# ]
