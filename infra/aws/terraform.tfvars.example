# Copy to terraform.tfvars (git-ignored) and adjust.

region      = "eu-central-1"
project     = "ryft"
environment = "prod"

# Who may reach the Kubernetes API. Your own address(es) (curl -s https://checkip.amazonaws.com)
# AND HCP Vault's egress addresses: its Kubernetes auth calls TokenReview on every login
# (infra/vault). Without Vault's, secret syncs stop; leave 0.0.0.0/0 until you know them.
# The API itself still requires IAM authentication.
endpoint_public_access_cidrs = ["0.0.0.0/0"]

deletion_protection = true

# Three nodes, one per zone (D57): 51 pod slots, one RabbitMQ node each, and every
# broker volume always has a node in its zone. The module ignores desired_size after
# creation; change it with
# aws eks update-nodegroup-config, then here.
node_group = {
  instance_types = ["t3.large"] # 35 pods and 8 GiB per node (D64); changing the type replaces the node group
  min_size       = 3
  max_size       = 4
  desired_size   = 3

  # Graviton is ~20 % cheaper; the RYFT images are multi-arch:
  # ami_type       = "AL2023_ARM_64_STANDARD"
  # instance_types = ["t4g.medium"]
}

# Access to the cluster. The identity that runs the apply is always a cluster admin (an access
# entry). Mode API ignores kube-system/aws-auth and cannot be reverted: do the read-only checks in
# docs/OPERATIONS.md (EKS authentication mode API) first, then pass -var='authentication_mode=API'
# on one reviewed plan; do not put it here before the checks are green.
# authentication_mode = "API_AND_CONFIG_MAP"
#
# Only if `aws eks list-access-entries` does not list the node group's role (EKS normally creates
# that EC2_LINUX entry itself; true on top of an existing one fails with ResourceInUseException):
# node_access_entry = true
#
# Only if your kubectl uses another IAM role/user than the one that runs terraform:
# admin_principal_arns = { me = "arn:aws:iam::111122223333:role/your-admin-role" }

tags = {
  Owner = "platform-team"
}

# Monthly cost alarm (AWS Budgets, USD; 165 ≈ €150): alerts at 80 % spent and 100 % forecast.
budget_alert_emails = ["you@example.com"]
# monthly_budget_usd = 165
