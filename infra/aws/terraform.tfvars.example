# Copy to terraform.tfvars (git-ignored) and adjust.

region      = "eu-central-1"
project     = "ryft"
environment = "prod"

# Who may reach the Kubernetes API. Your own address(es) (curl -s https://checkip.amazonaws.com)
# AND HCP Vault's egress addresses: its Kubernetes auth calls TokenReview on every login
# (infra/vault). Without Vault's, secret syncs stop; leave 0.0.0.0/0 until you know them.
endpoint_public_access_cidrs = ["203.0.113.10/32"]

deletion_protection = true

node_group = {
  instance_types = ["t3.medium"]
  min_size       = 2
  max_size       = 4
  desired_size   = 2

  # Graviton is ~20 % cheaper; the RYFT images are multi-arch:
  # ami_type       = "AL2023_ARM_64_STANDARD"
  # instance_types = ["t4g.medium"]
}

tags = {
  Owner = "platform-team"
}

# Monthly cost alarm (AWS Budgets, USD; 165 ≈ €150): alerts at 80 % spent and 100 % forecast.
budget_alert_emails = ["you@example.com"]
# monthly_budget_usd = 165
