{
  "statefulset-rabbitmq-server": {
    "apiVersion": "apps/v1",
    "kind": "StatefulSet",
    "metadata": {
      "name": "rabbitmq-server",
      "namespace": "ryft-rabbitmq"
    },
    "spec": {
      "replicas": 3,
      "serviceName": "rabbitmq-nodes",
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "rabbitmq"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/name": "rabbitmq"
          },
          "annotations": {
            "prometheus.io/scrape": "true"
          }
        },
        "spec": {
          "serviceAccountName": "rabbitmq-server",
          "automountServiceAccountToken": true,
          "initContainers": [
            {
              "name": "setup-container",
              "image": "docker.io/library/rabbitmq:4.3.6-management@sha256:54cb013d76cd1fd6c0a0708f34062ad61c452bb6f016b434c6c33f1a765d2b58",
              "command": [
                "sh",
                "-c",
                "cp /tmp/x /var/y"
              ]
            }
          ],
          "containers": [
            {
              "name": "rabbitmq",
              "image": "docker.io/library/rabbitmq:4.3.6-management@sha256:54cb013d76cd1fd6c0a0708f34062ad61c452bb6f016b434c6c33f1a765d2b58",
              "args": [
                "--x"
              ],
              "lifecycle": {
                "preStop": {
                  "exec": {
                    "command": [
                      "/bin/bash",
                      "-c",
                      "rabbitmq-upgrade await_online_quorum_plus_one"
                    ]
                  }
                }
              },
              "readinessProbe": {
                "tcpSocket": {
                  "port": "amqps"
                }
              },
              "env": [
                {
                  "name": "MY_POD_NAME",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.name"
                    }
                  }
                },
                {
                  "name": "RABBITMQ_ERLANG_COOKIE",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "rabbitmq-erlang-cookie",
                      "key": "cookie"
                    }
                  }
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "kube-api-access-xyz",
              "projected": {
                "sources": [
                  {
                    "serviceAccountToken": {
                      "path": "token",
                      "expirationSeconds": 3607
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  },
  "cronjob-c": {
    "apiVersion": "batch/v1",
    "kind": "CronJob",
    "metadata": {
      "name": "c",
      "namespace": "ryft-api"
    },
    "spec": {
      "jobTemplate": {
        "spec": {
          "template": {
            "spec": {
              "automountServiceAccountToken": false,
              "containers": [
                {
                  "name": "c",
                  "image": "busybox"
                }
              ]
            }
          }
        }
      }
    }
  },
