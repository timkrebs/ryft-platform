  },
  "secret-ryft-secrets-2": {
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": {
      "name": "ryft-secrets",
      "namespace": "ryft-api"
    },
    "data": {
      "AUTH_MODE": "c3VwYWJhc2U="
    }
  },
  "secret-ryft-secrets-3": {
    "apiVersion": "v1",
