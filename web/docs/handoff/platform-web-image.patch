diff --git a/deploy/argocd/apps/vault-web.yaml b/deploy/argocd/apps/vault-web.yaml
new file mode 100644
index 0000000..fd1241c
--- /dev/null
+++ b/deploy/argocd/apps/vault-web.yaml
@@ -0,0 +1,28 @@
+# Wave 0: ryft-web's Vault Secrets Operator objects (generated by infra/vault into
+# deploy/k8s/overlays/vault-namespaces/web; Terraform writes them, Argo CD applies
+# them): the pull secret ghcr-pull for the site's private image.
+apiVersion: argoproj.io/v1alpha1
+kind: Application
+metadata:
+  name: vault-web
+  namespace: argocd
+  annotations:
+    # Diffs computed by the API server (dry-run apply): defaulted fields such as a
+    # StatefulSet's volumeClaimTemplates status are not drift.
+    argocd.argoproj.io/compare-options: ServerSideDiff=true
+    argocd.argoproj.io/sync-wave: "0"
+spec:
+  project: ryft
+  source:
+    repoURL: https://github.com/timkrebs/ryft-platform.git
+    targetRevision: main
+    path: deploy/k8s/overlays/vault-namespaces/web
+  destination:
+    server: https://kubernetes.default.svc
+    namespace: ryft-web
+  syncPolicy:
+    automated: { prune: true, selfHeal: true }
+    syncOptions: [ServerSideApply=true, PruneLast=true, CreateNamespace=false]
+    # A failed sync of the same commit is not retried by automated sync itself:
+    # twice more, for what passes (a pooler blip during migrate, a slow smoke).
+    retry: { limit: 2, backoff: { duration: 1m, factor: 2, maxDuration: 5m } }
