+# Generated by infra/vault — do not edit by hand (terraform apply rewrites it).
+apiVersion: secrets.hashicorp.com/v1beta1
+kind: VaultConnection
+metadata:
+  name: vault
+  namespace: ryft-web
+spec:
+  address: https://vault.example.hashicorp.cloud:8200
+  skipTLSVerify: false
+---
+apiVersion: secrets.hashicorp.com/v1beta1
+kind: VaultAuth
+metadata:
+  name: web
+  namespace: ryft-web
+spec:
+  vaultConnectionRef: vault
+  # From the root namespace: on HCP Vault Dedicated this starts with admin/.
+  namespace: admin/ryft/web
+  method: kubernetes
+  mount: kubernetes
+  kubernetes:
+    role: web
+    serviceAccount: web
+    audiences: ["vault"]
+---
+apiVersion: secrets.hashicorp.com/v1beta1
+kind: VaultStaticSecret
+metadata:
+  name: ghcr-pull
+  namespace: ryft-web
+spec:
+  vaultAuthRef: web
+  mount: kv
+  type: kv-v2
+  path: ghcr-pull
+  refreshAfter: 1h
+  destination:
+    name: ghcr-pull
+    create: true
+    overwrite: true
+    # The kubelet reads imagePullSecrets of this type only.
+    type: kubernetes.io/dockerconfigjson
+    transformation:
+      excludeRaw: true
