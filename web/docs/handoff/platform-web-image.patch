+# The private image's pull secret (registry_pull): Docker's config JSON for ghcr.io, which
+# the operator writes as Secret ghcr-pull of type kubernetes.io/dockerconfigjson. Rotate
+# the token in terraform.tfvars and apply; the operator updates the Secret within an
+# hour, and the kubelet uses it on the next pull (nothing restarts).
+resource "vault_kv_secret_v2" "ghcr_pull" {
+  for_each = local.registry_pull
+
+  namespace           = vault_namespace.service[each.key].path_fq
+  mount               = vault_mount.kv[each.key].path
+  name                = "ghcr-pull"
+  delete_all_versions = true
+  data_json = jsonencode({
+    ".dockerconfigjson" = jsonencode({ auths = { "ghcr.io" = {
+      username = var.ghcr_pull_user
+      password = var.ghcr_pull_token
+      auth     = base64encode("${var.ghcr_pull_user}:${var.ghcr_pull_token}")
+    } } })
+  })
+}
+
 resource "vault_policy" "service" {
   for_each = local.services
 
