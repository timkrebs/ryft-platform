{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/de",
        "http://localhost:8080/science",
        "http://localhost:8080/beta",
        "http://localhost:8080/privacy"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              { "maxNumericValue": 1500, "aggregationMethod": "median-run" }
            ],
            "cumulative-layout-shift": [
              "error",
              { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }
            ],
            "total-blocking-time": ["error", { "maxNumericValue": 100, "aggregationMethod": "median-run" }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 81920 }],
            "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:8080/(de|science|beta)?$",
          "assertions": { "categories:seo": ["error", { "minScore": 0.9 }] }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
