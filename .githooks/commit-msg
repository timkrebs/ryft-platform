#!/bin/sh
# The brand guard on the commit message: every commit in this repository, not only web/.
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v node >/dev/null 2>&1; then
  echo "commit-msg: node is not installed, brand check on the message skipped (CI checks it on the PR)." >&2
  exit 0
fi
exec node web/scripts/check-brand.mjs --message "$1"
