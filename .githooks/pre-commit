#!/bin/sh
# The brand guard on the staged files under web/ (web/scripts/check-brand.mjs,
# web/config/brand-denylist.json). Other staged files are not its business: the rule for
# them is the commit message check (commit-msg) and CI.
hooks=$(dirname "$0")
. "$hooks/_node.sh"
cd "$(git rev-parse --show-toplevel)" || exit 1
git diff --cached --quiet --diff-filter=d -- web && exit 0
ensure_node || no_node pre-commit
exec node web/scripts/check-brand.mjs --staged
