## fold that folds
1. begin [args=0]
2. SELECT pg_advisory_xact_lock(7419005, hashtext($1::text)) [args=1]
3. SELECT id, activity, start_at, end_at, source, created_at, session_id IS NOT NULL FROM workouts WHERE user_id=$1 AND source <> $2 AND source = ANY($3) AND start_at >= $4 AND start_at <= $5 ORDER BY start_at, id LIMIT 5001 FOR UPDATE [args=5]
4. DELETE FROM workouts WHERE user_id=$1 AND id = ANY($2) AND source <> $3 [args=3]
5. INSERT INTO score_queue (user_id, day, queued_at, scored_at) SELECT $1, d::date, now(), NULL FROM unnest($2::text[]) WITH ORDINALITY AS u(d, n) ORDER BY n ON CONFLICT (user_id, day) DO UPDATE SET queued_at = now(), scored_at = NULL [args=2]
6. INSERT INTO outbox (publisher, user_id, routing_key, payload) VALUES ('ingest', $1, 'ingested', '{}'::jsonb) [args=1]
7. commit [args=0]

