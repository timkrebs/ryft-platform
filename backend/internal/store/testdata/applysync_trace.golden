3. DELETE FROM samples WHERE user_id=$1 AND hk_id = ANY($2) RETURNING type, start_at [args=2]
4. DELETE FROM sleep_segments WHERE user_id=$1 AND hk_id = ANY($2) RETURNING end_at [args=2]
5. DELETE FROM workouts WHERE user_id=$1 AND id = ANY($2) AND source <> $3 RETURNING start_at, session_id IS NOT NULL [args=3]
6. SELECT id, activity, start_at, end_at, source, created_at, session_id IS NOT NULL FROM workouts WHERE user_id=$1 AND source <> $2 AND source = ANY($3) AND start_at >= $4 AND start_at <= $5 ORDER BY start_at, id LIMIT 5001 FOR UPDATE [args=5]
7. DELETE FROM workouts WHERE user_id=$1 AND id = ANY($2) AND source <> $3 [args=3]
8. INSERT INTO score_queue (user_id, day, queued_at, scored_at) SELECT $1, d::date, now(), NULL FROM unnest($2::text[]) WITH ORDINALITY AS u(d, n) ORDER BY n ON CONFLICT (user_id, day) DO UPDATE SET queued_at = now(), scored_at = NULL [args=2]
9. INSERT INTO outbox (publisher, user_id, routing_key, payload) VALUES ('ingest', $1, 'ingested', '{}'::jsonb) [args=1]
10. commit [args=0]

