4. DELETE FROM sleep_segments WHERE user_id=$1 AND hk_id = ANY($2) RETURNING end_at [args=2]
5. DELETE FROM workouts WHERE user_id=$1 AND id = ANY($2) AND source <> $3 RETURNING start_at, session_id IS NOT NULL [args=3]
6. INSERT INTO score_queue (user_id, day, queued_at, scored_at) SELECT $1, d::date, now(), NULL FROM unnest($2::text[]) WITH ORDINALITY AS u(d, n) ORDER BY n ON CONFLICT (user_id, day) DO UPDATE SET queued_at = now(), scored_at = NULL [args=2]
