# The shared, non-secret configuration of the Cloud Run services and the migrate job (D223). Values live
# here, in git, never in repository variables: a change is a reviewed PR, and the merge's deploy.yml
# rolls it out. scripts/cloudrun_render.py reads this file with a fixed list of keys and builds the
# derived values (DATABASE_URL from the ref and the pooler host, PUSH_AUDIENCE from the project
# number); it refuses to render while a FILL_ME_IN is left or a value has the wrong shape.
# Format: KEY=value, one per line, no quotes, no spaces, no inline comments.

# The privacy policy version users consent to (D78). Its page must exist in English and German and be
# status: published before a PR may set it here: the merge puts it into force on GCP
# (scripts/check_policy_in_force.sh, web/scripts/check-policy-version.mjs). Until D3 the copies in
# deploy/k8s/base/{api,ingest}/config.env must equal it.
PRIVACY_POLICY_VERSION=2026-10-26
LOG_LEVEL=info

# Known only after the bootstrap (docs/OPERATIONS.md → GCP). The user fills them in one config PR before
# the first deploy (runbook step 8); none of them is a secret.
# gcloud projects describe ryftlab-prod --format='value(projectNumber)'
GCP_PROJECT_NUMBER=FILL_ME_IN
# ryft-push's unique ID, the `sub` of its tokens: terraform -chdir=infra/gcp output -raw push_sa_unique_id
PUSH_SA_ID=FILL_ME_IN
# Supabase → Project Settings → General → Project ID (20 lower-case letters)
SUPABASE_PROJECT_REF=FILL_ME_IN
# Supabase → Connect → Transaction pooler: the host only, aws-<n>-eu-central-1.pooler.supabase.com
SUPABASE_POOLER_HOST=FILL_ME_IN
# Apple Developer → Keys: the Sign in with Apple key (10 characters; api)
APPLE_KEY_ID=FILL_ME_IN
# Apple Developer → Keys: the APNs key (10 characters; notify)
APNS_KEY_ID=FILL_ME_IN
# Grafana Cloud → the stack → OpenTelemetry: the OTLP endpoint (https://otlp-gateway-prod-<region>.grafana.net/otlp)
# and the instance ID (a number). Both empty means the services push no metrics (runbook step 11 fills
# them); one without the other is refused.
OTLP_ENDPOINT=
OTLP_USER=
