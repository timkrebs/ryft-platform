# The shared, non-secret configuration of the Cloud Run services and the migrate job (D223). Values live
# here, in git, never in repository variables: a change is a reviewed PR, and the merge's deploy.yml
# rolls it out. scripts/cloudrun_render.py reads this file with a fixed list of keys and builds the
# derived values (DATABASE_URL from the ref and the pooler host, PUSH_AUDIENCE from the project
# number); it refuses to render while a FILL_ME_IN is left or a value has the wrong shape.
# Format: KEY=value, one per line, no quotes, no spaces, no inline comments.

# The privacy policy version users consent to (D78). Its page must exist in English (the site is
# English only, D230) and be status: published before a PR may set it here: the merge puts it into
# force on GCP (scripts/check_policy_in_force.sh, web/scripts/check-policy-version.mjs), and deploy.yml's
# site job checks that the live ryftlab.de/privacy shows it (C1). docker-compose.yml's copy (the local
# stack) must equal it.
PRIVACY_POLICY_VERSION=2026-10-26
LOG_LEVEL=info

# The beta gate of api and ingest (D79, D87, D238, D241): off, warn or on, lower case. off: the beta has
# no invite codes (the user's decision, 2026-11-18). Any signed-in account is served, nothing is flagged,
# and access on the server is to come with App Attest, which is still to be decided (D241). warn would
# flag an account without beta access (no redeemed code, no operator grant) with X-RYFT-Gate:
# invite_required; on would refuse it with 403 invite_required outside onboarding's routes. A gate starts
# again with a PR of this one line to warn, never straight to on, and follows docs/OPERATIONS.md → GCP →
# The beta gate. CONSENT_ENFORCE is not set here: the services' default, on, holds (D78).
BETA_GATE=off

# App Attest in api and ingest (D245, D247): off, warn or on, lower case. off: no token is read; the
# three /v1/app-attest routes answer 501 until the ring is pinned. warn checks the X-RYFT-App-Token and
# logs each request without a valid one (msg "app attest"), refusing nothing; on refuses it with 403
# app_attest_required outside the exempt routes and users. The order is off -> warn -> on, never straight
# to on: scripts/check_cloudrun.py refuses off -> on against the pull request's base. warn and on need the
# ring, APP_ATTEST_TOKEN_KEYS from the secret app-attest-token-key, pinned by version in api.yaml and
# ingest.yaml in the same PR (the services refuse to start without it, and so does the check). The flip
# follows docs/OPERATIONS.md -> GCP -> App Attest; its rollback is the line back.
APP_ATTEST=off
# The accounts App Attest never asks (D245): empty, or 1 to 5 lower-case UUIDs, comma-separated, no
# spaces. The smoke user's id goes in with the warn flip, so deploy.yml's smoke and make smoke-prod pass
# under on. A test account's id names nobody and is no secret.
APP_ATTEST_EXEMPT_USERS=

# How many X-Forwarded-For entries the proxies in front of api and ingest append (D53, D240): the
# per-address edge limit takes the client as that many entries from the right and ignores what is left
# of it. Cloud Run's front end appends one: 1. Behind the external Application Load Balancer it is 2,
# and only with ingress internal-and-cloud-load-balancing on both services: with ingress all a client
# reaches run.app directly and writes the entry 2 would take (scripts/check_cloudrun.py refuses that).
XFF_TRUSTED_HOPS=2

# Direct connections (D257, design §9), the per-deploy switch: the providers api and ingest serve, a
# comma list of their ids (each once, no spaces), empty until phase 2. One line, so api and ingest are
# always equal (scripts/check_cloudrun.py checks the rendered pair too). Only garmin may be named here:
# the fake provider is compose only (CONNECT_FAKE=on, which config refuses on Cloud Run, and which no
# template may set). garmin goes in only in the PR that pins connect-garmin-client-secret by version and
# sets CONNECT_GARMIN_CLIENT_ID in api.yaml and a cap above 0 below (check_cloudrun.py refuses it before).
CONNECT_PROVIDERS=
# How many accounts may hold a Garmin connection at once (design §6.1; api counts connected and
# needs_reauth connections plus pending starts): a whole number, 0 until phase 2 sets the programme's.
# Required, so the cap in force is the one in git.
CONNECT_GARMIN_USER_CAP=0
# The consent cutoff (D259), ingest only: the oldest health-processing consent version whose pushes the
# hook and the consumer still accept (a consent not withdrawn, to this version or a later one). Empty
# means the policy in force (PRIVACY_POLICY_VERSION, D257's behaviour); otherwise a YYYY-MM-DD date not
# after PRIVACY_POLICY_VERSION (check_cloudrun.py refuses a later one). Move it only when a policy change
# touches how health data is processed; a wording change leaves it. Pinned (not empty), so a policy
# PR that forgets it keeps older consents rather than dropping them (docs/OPERATIONS.md → Moving the
# consent cutoff). api's start and confirm keep requiring consent to the policy in force, so api.yaml
# never sets it.
CONNECT_MIN_POLICY_VERSION=2026-10-26

# Known only after the bootstrap (docs/OPERATIONS.md → GCP, step 7a); none of them is a secret. Set on
# 2026-11-15 with the values the user confirmed (PR A2).
# gcloud projects describe ryftlab-prod --format='value(projectNumber)'
GCP_PROJECT_NUMBER=49741851924
# ryft-push's unique ID, the `sub` of its tokens: terraform -chdir=infra/gcp output -raw push_sa_unique_id
PUSH_SA_ID=100999984647275261823
# Supabase → Project Settings → General → Project ID (20 lower-case letters)
SUPABASE_PROJECT_REF=ydgbemufggwnegbnjhkm
# Supabase → Connect → Transaction pooler: the host only, aws-<n>-eu-central-1.pooler.supabase.com
SUPABASE_POOLER_HOST=aws-1-eu-central-1.pooler.supabase.com
# Apple Developer → Keys: the Sign in with Apple key (10 characters; api). One key with both services,
# Sign in with Apple and APNs, so the two IDs are the same.
APPLE_KEY_ID=3GY48KHYHL
# Apple Developer → Keys: the APNs key (10 characters; notify)
APNS_KEY_ID=3GY48KHYHL

# The production smoke's identity (D286): a Google ID token of the service account ryft-smoke, which api
# and ingest map to the smoke account and to nobody else. deploy.yml's preflight and make smoke-prod mint
# it as ryft-deployer (no secret anywhere). Neither value is a secret. Both are required: a deploy
# refuses a FILL_ME_IN, --lint in CI lets it pass until the config PR sets them.
# The dedicated smoke account's Supabase user id (a lower-case UUID; it names nobody): the auth.users row
# with the email smoke@ryftapp.de, the one bind_smoke_account.sql binds
SMOKE_USER_ID=671779e8-9634-4964-b3a6-4445c6ad1c5f
# ryft-smoke's unique ID, the `sub` of its tokens: terraform -chdir=infra/gcp output -raw smoke_sa_unique_id
SMOKE_SA_ID=103906138219865212730
