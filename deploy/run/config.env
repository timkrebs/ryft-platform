# The shared, non-secret configuration of the Cloud Run services and the migrate job (D223). Values live
# here, in git, never in repository variables: a change is a reviewed PR, and the merge's deploy.yml
# rolls it out. scripts/cloudrun_render.py reads this file with a fixed list of keys and builds the
# derived values (DATABASE_URL from the ref and the pooler host, PUSH_AUDIENCE from the project
# number); it refuses to render while a FILL_ME_IN is left or a value has the wrong shape.
# Format: KEY=value, one per line, no quotes, no spaces, no inline comments.

# The privacy policy version users consent to (D78). Its page must exist in English (the site is
# English only, D230) and be status: published before a PR may set it here: the merge puts it into
# force on GCP (scripts/check_policy_in_force.sh, web/scripts/check-policy-version.mjs), and deploy.yml's
# site job checks that the live ryftlab.de/privacy shows it (C1). Until D3 the copies in
# deploy/k8s/base/{api,ingest}/config.env must equal it.
PRIVACY_POLICY_VERSION=2026-10-26
LOG_LEVEL=info

# The beta gate of api and ingest (D79, D87, D238, D241): off, warn or on, lower case. off: the beta has
# no invite codes (the user's decision, 2026-11-18). Any signed-in account is served, nothing is flagged,
# and access on the server is to come with App Attest, which is still to be decided (D241). warn would
# flag an account without beta access (no redeemed code, no operator grant) with X-RYFT-Gate:
# invite_required; on would refuse it with 403 invite_required outside onboarding's routes. Either is a PR
# of this one line, with the steps in docs/OPERATIONS.md → GCP → The beta gate. CONSENT_ENFORCE is not set
# here: the services' default, on, holds (D78).
BETA_GATE=off

# Known only after the bootstrap (docs/OPERATIONS.md → GCP, step 7a); none of them is a secret. Set on
# 2026-11-15 with the values the user confirmed (PR A2).
# gcloud projects describe ryftlab-prod --format='value(projectNumber)'
GCP_PROJECT_NUMBER=49741851924
# ryft-push's unique ID, the `sub` of its tokens: terraform -chdir=infra/gcp output -raw push_sa_unique_id
PUSH_SA_ID=100999984647275261823
# Supabase → Project Settings → General → Project ID (20 lower-case letters)
SUPABASE_PROJECT_REF=ydgbemufggwnegbnjhkm
# Supabase → Connect → Transaction pooler: the host only, aws-<n>-eu-central-1.pooler.supabase.com
SUPABASE_POOLER_HOST=aws-1-eu-central-1.pooler.supabase.com
# Apple Developer → Keys: the Sign in with Apple key (10 characters; api). One key with both services,
# Sign in with Apple and APNs, so the two IDs are the same.
APPLE_KEY_ID=3GY48KHYHL
# Apple Developer → Keys: the APNs key (10 characters; notify)
APNS_KEY_ID=3GY48KHYHL
