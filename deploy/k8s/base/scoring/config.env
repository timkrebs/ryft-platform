# Non-secret settings. DATABASE_URL and the RabbitMQ credentials come from Secret
# ryft-secrets (Vault).
# RabbitMQ (D97): mutual TLS on 5671, the service's certificate and the internal CA
# from Secret amqp-client; AMQP_USER and AMQP_PASSWORD come from Vault.
AMQP_URL=amqps://rabbitmq.ryft-rabbitmq.svc.cluster.local:5671/ryft
AMQP_CA_FILE=/etc/ryft/amqp/ca.crt
AMQP_CERT_FILE=/etc/ryft/amqp/tls.crt
AMQP_KEY_FILE=/etc/ryft/amqp/tls.key
PORT=8080
LOG_LEVEL=info
