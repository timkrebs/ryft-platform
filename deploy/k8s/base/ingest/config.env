# Non-secret settings. SUPABASE_PROJECT_REF, DATABASE_URL and the RabbitMQ credentials
# come from Secret ryft-secrets (Vault).
# RabbitMQ (D97): mutual TLS on 5671, the service's certificate and the internal CA
# from Secret amqp-client; AMQP_USER and AMQP_PASSWORD come from Vault.
AMQP_URL=amqps://rabbitmq.ryft-rabbitmq.svc.cluster.local:5671/ryft
AMQP_CA_FILE=/etc/ryft/amqp/ca.crt
AMQP_CERT_FILE=/etc/ryft/amqp/tls.crt
AMQP_KEY_FILE=/etc/ryft/amqp/tls.key
PORT=8080
AUTH_MODE=supabase
LOG_LEVEL=info
# The privacy policy version that is published (the newest page at ryftapp.de/privacy; local
# stacks use it as is). EKS runs the version in force, a pin in overlays/eks/kustomization.yaml
# that promote moves when it pins the web image carrying the page (D78, F1). A new version
# makes everyone consent again before the next sync.
PRIVACY_POLICY_VERSION=2026-10-26
PRIVACY_POLICY_URL=https://ryftapp.de/privacy
